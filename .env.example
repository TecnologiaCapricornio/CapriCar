PORT=3000
NODE_ENV=development

PGHOST=localhost
PGPORT=5432
PGDATABASE=capricar
PGUSER=capricar_app
PGPASSWORD=COLOQUE_A_SENHA_DO_CAPRICAR_APP

SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

# Necessárias apenas na primeira carga de um banco vazio.
ADMIN_INITIAL_PASSWORD=DEFINA_UMA_SENHA_FORTE
FACILITIES_INITIAL_PASSWORD=DEFINA_UMA_SENHA_FORTE

# Backup local. O diretório padrão é ./backups.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Opcional. Se definida, novos backups são cifrados (AES-256-GCM) e o
# arquivo .backup original em texto claro é removido após a cifragem.
# A mesma chave é necessária para restaurar um backup .backup.enc.
# BACKUP_ENCRYPTION_KEY=
