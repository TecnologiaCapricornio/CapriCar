PORT=3000
NODE_ENV=development

PGHOST=localhost
PGPORT=5432
PGDATABASE=capricar
PGUSER=capricar_app
PGPASSWORD=COLOQUE_A_SENHA_DO_CAPRICAR_APP

SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

# Necessárias apenas na primeira carga de um banco vazio.
ADMIN_INITIAL_PASSWORD=DEFINA_UMA_SENHA_FORTE
FACILITIES_INITIAL_PASSWORD=DEFINA_UMA_SENHA_FORTE

# Backup local. O diretório padrão é ./backups.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Opcional. Se definida, novos backups são cifrados (AES-256-GCM) e o
# arquivo .backup original em texto claro é removido após a cifragem.
# A mesma chave é necessária para restaurar um backup .backup.enc.
# BACKUP_ENCRYPTION_KEY=

# Login via Microsoft Entra ID (opcional). Deixe as três variáveis abaixo
# em branco para manter apenas o login local. Estas variáveis agora servem
# apenas de fallback: o administrador pode configurar o SSO diretamente
# pelo Painel de Administração > Integrações, o que passa a ter prioridade
# sobre estas variáveis quando definido.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# A sincronização de reservas com o calendário do Outlook (Painel de
# Administração > Integrações) reaproveita essas mesmas credenciais do
# Entra ID e não precisa de nenhuma variável nova — só exige adicionar a
# permissão de aplicativo Calendars.ReadWrite (com consentimento de
# administrador) ao mesmo App Registration usado acima.

# Necessária para salvar credenciais de integração (segredo do Entra ID,
# senha do SMTP) de forma reversível no banco de dados. Sem esta variável,
# não é possível salvar essas credenciais pelo Painel de Administração.
# SETTINGS_ENCRYPTION_KEY=
